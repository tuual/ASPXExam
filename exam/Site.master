<%@Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="SiteMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mobarch Dashboard</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" /> 
    <link href="~/Content/Site.css" rel="stylesheet" /> 
    <script type="text/javascript" src="/Scripts/jquery.min.js"></script>
    <script type="text/javascript" src="/Scripts/popper.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.lineicons.com/4.0/lineicons.css" rel="stylesheet" />


    <style>
        /* Sidebar */
#sidebar {
    width: auto ;
    position: fixed;
    top: 50px; /* Navbar yüksekliği kadar aşağıdan başlasın */
    left: -250px;
    height: calc(100vh - 50px);
    background: #fff;
    box-shadow: 2px 0px 5px rgba(0,0,0,0.1);
    overflow-y: auto;
    transition: all 0.3s ease-in-out;
    z-index: 1050;
    padding: 5px 0px;
}

#sidebar.active {
    left: 0;
}

/* Sidebar açılınca içerik kaymasın */
.sidebar-open #main-content {
    margin-left: 250px;
    transition: margin-left 0.3s ease-in-out;
}

/* Sidebar içeriği */
#sidebar h4 {
    text-align: left;
    padding: 15px 10px;
    margin: 0 0 0px 0;
    background: #fff ;
    color: #0e2238;
}

.sidebar-footer {
    position: absolute;
    bottom: 20px;
    width: 90%;
    left: 5%;
    text-align: center;
}
#sidebar .accordion-body .list-group-item a {
    font-size: 13px;
    color: #0e2238;
    text-decoration: none;
}

#sidebar .accordion-body .list-group-item a:hover {
    text-decoration: none;
    
}


.tree-toggle-arrow {
    font-size: 16px;
    margin-right: 8px;
    transition: transform 0.3s ease;
    display: inline-block;
}
.accordion-button:not(.collapsed) .tree-toggle-arrow {
    transform: rotate(90deg);
}
.accordion-button{
    background: #ffff;
    color:#0e2238;
}

.tree-child {
    padding-left: 25px;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    background:#fff;
    color:#0e2238;

}

.tree-child-arrow {
    font-size: 13px;
    color: #0e2238;
}
    .rotate {
      transform: rotate(90deg);
      transition: transform 0.3s ease;
  }

/* Mobil görünüm */
@media (max-width: 768px) {
    #sidebar {
        width: 100%;
        left: -100%;
    }
    .user-dropdown
    {
         top: 80%;
        left: 50%;
        transform: translateX(-50%);
    }

    #sidebar.active {
        left: 0;
    }

    .sidebar-open #main-content {
        margin-left: 0;
    }
}





        /* Navbar */
        #Navbar {
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1100;
            background: #fff;
            box-shadow: 0px 2px 5px rgba(0,0,0,0.1);
            padding: 0.5rem 1rem;
        }

        /* User Dropdown */
        .user-dropdown {
              position: absolute; /* Fixed position to right side */
            top: 50%;
            right: 0;
            transform: translateY(-50%);
        }

        .user-dropdown .dropdown-toggle {
            background-color: #007bff;
            color: #fff;
            border: none;
            padding: 8px 15px;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
        }

        .user-dropdown .dropdown-menu {
            position: absolute;
            right: 0;
            top: 100%;
            min-width: 160px;
            background-color: #fff;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            display: none;
        }   

          .dropdown-menu.show {
       display: block !important;
       opacity: 1;
       transform: translateY(0);
   }
   
          /* Yeni: Küçük, yuvarlak ikon buton */
.icon-button {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: none;
    background-color: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
}

.icon-button:hover {
    background-color: #e9ecef;
}

/* Dropdown menü sağa taşmasın */
.dropdown-menu {
    right: 0 !important;
    left: auto !important;
    transform: none !important;
    margin-top: 5px;
}

.dropdown-menu .dropdown-item {
    font-size: 14px;
    padding: 10px 15px;
    color: #212529;
    transition: background-color 0.2s;
}

.dropdown-menu .dropdown-item:hover {
    background-color: #f1f1f1;
    color: #0d6efd;
}

.btn-outline-secondary {
    border-color: #ced4da;
    color: #0e2238;
}

.btn-outline-secondary:hover {
    background-color: #e9ecef;
}

        .btnHover:hover{
            background-color: #BDBDBD;
        }
        

         .animated-dropdown {
     opacity: 0;
     transform: translateY(-10px);
     transition: opacity 0.3s ease, transform 0.3s ease;
     display: none; /* Başlangıçta gizli */
 }

 .dropdown.show .animated-dropdown {
     display: block; /* Görünür yap */
     opacity: 1;
     transform: translateY(0);
 }
    </style>
</head>
<body>
    <form id="form1" runat="server" >
    
    <!-- NAVBAR -->
  <nav id="Navbar" runat="server" class="navbar navbar-expand-lg navbar-light fixed-top bg-light">
    <div class="container-fluid">
        <!-- Sol taraftaki 3 çizgili buton -->
        <button id="toggleSidebar" type="button" class="btn btn-dark me-2">&#9776;</button>
        </div>
        <!-- Sağ taraftaki kullanıcı menüsü -->
     <div class="dropdown ms-auto">
  <button class="btn icon-button" type="button" id="userDropdown" aria-expanded="false">
    <i class="lni lni-cog fs-5"></i>
  </button>
  <ul class="dropdown-menu dropdown-menu-end animated-dropdown" aria-labelledby="userDropdown" runat="server">
        <<li class="dropdown-header text-center">
    <span class="badge bg-primary text-light rounded-pill px-3 py-2">
        <asp:Literal ID="selectedCompanyName" runat="server" />
    </span>
</li>

    <li><asp:LinkButton ID="lnkUserAdd" runat="server" CssClass="dropdown-item" Text="Kullanıcı Ekle" OnClick="lnkUserAdd_Click" /></li>
<li>
  <a class="dropdown-item" href="javascript:void(0);" onclick="$('#modalSirketDegistirme').modal('show');">
    Şirket Değiştir
  </a>
</li>

    <li><asp:Button ID="Button1" runat="server" Text="Çıkış Yap" CssClass="dropdown-item text-danger" OnClick="btnLogout_Click" /></li>
  </ul>
</div>
</nav>


    <!-- SIDEBAR -->
    <div id="sidebar" runat="server">
        <h4>Raporlar</h4>
        <ul id="reportList" class="list-group">
            <asp:Literal ID="ltReports" runat="server"></asp:Literal>
        </ul>
    </div>

    <div id="main-content">
        <asp:ContentPlaceHolder ID="Content" runat="server">
        </asp:ContentPlaceHolder>
    </div>

    <!-- Modal: Şirket Seçme -->
   <!-- MODAL: Şirket Değiştir -->
<div class="modal fade" id="modalSirketDegistirme" tabindex="-1" aria-labelledby="modalSirketDegistirmeLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 500px;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Şirket Değiştir</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
      </div>
      <div class="modal-body" style="padding: 0; height: 400px;">
        <iframe id="iframeSirketDegistirme" src="/Account/SirketDegistirme.aspx" width="100%" height="100%" style="border: none;"></iframe>
      </div>
    </div>
  </div>
</div>




    </form>

    <script>
        document.getElementById("toggleSidebar").addEventListener("click", function () {
            let sidebar = document.getElementById("sidebar");
            let body = document.body;
            let mainContent = document.getElementById("main-content");

            sidebar.classList.toggle("active");
            document.body.classList.toggle("sidebar-open");

            if (sidebar.classList.contains("active")) {
                body.style.overflow = "hidden"; // Sidebar açılınca scroll kapat
            } else {
                body.style.overflow = "auto"; // Kapatınca geri aç
            }
        });


     

    </script>

    <script>
        const dropdownBtn = document.getElementById("userDropdown");
        const dropdownMenu = document.getElementById("userDropdownMenu");

        // Tıklandığında aç / kapa
        dropdownBtn.addEventListener("click", function (e) {
            e.stopPropagation(); // Tıklama dışarı yansımasın

            const isVisible = dropdownMenu.classList.contains("show");

            // Diğer açık dropdownları kapat
            document.querySelectorAll('.dropdown-menu.show').forEach(menu => {
                menu.classList.remove("show");
                menu.style.display = "none";
            });

            if (!isVisible) {
                dropdownMenu.style.display = "block";
                setTimeout(() => dropdownMenu.classList.add("show"), 10);
            }
        });

        // Sayfanın başka bir yerine tıklanırsa menüyü kapat
        document.addEventListener("click", function (e) {
            if (!dropdownMenu.contains(e.target) && !dropdownBtn.contains(e.target)) {
                dropdownMenu.classList.remove("show");
                dropdownMenu.style.display = "none";
            }
        });

        // Menüdeki bir linke tıklanırsa menüyü kapat
        dropdownMenu.querySelectorAll(".dropdown-item").forEach(item => {
            item.addEventListener("click", function () {
                dropdownMenu.classList.remove("show");
                dropdownMenu.style.display = "none";
            });
        });
    </script>


    <script>
        function closeAllAccordions() {
            const accordions = document.querySelectorAll('.accordion-collapse');
            accordions.forEach(acc => {
                acc.classList.remove('show');
            });
        }

        // Rapor linkine tıklandığında sidebar'ı kapatmak istersen:
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('#sidebar .list-group-item a').forEach(link => {
                link.addEventListener('click', function () {
                    document.getElementById("sidebar").classList.remove("active");
                    document.body.classList.remove("sidebar-open");
                    document.body.style.overflow = "auto";
                });
            });
        });

    </script>
    <script>
        document.getElementById("userDropdown").addEventListener("click", function () {
            console.log("Dropdown button clicked"); // Bu satır tetikleniyor mu kontrol edin
            const dropdownMenu = this.nextElementSibling;

            if (dropdownMenu.style.display === "block") {
                dropdownMenu.style.display = "none";
                dropdownMenu.classList.remove("show");
            } else {
                dropdownMenu.style.display = "block";
                setTimeout(() => dropdownMenu.classList.add("show"), 10); // Animasyonu tetikle
            }
        });
    </script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
